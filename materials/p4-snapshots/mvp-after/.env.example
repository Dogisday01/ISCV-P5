APP_NAME="P3 Universal MVP"
ENVIRONMENT="local"
DEBUG=false
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-with-a-long-random-secret-before-running"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
DATABASE_URL="sqlite:///./p3_mvp.db"
REQUEST_BODY_MAX_BYTES=1048576
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
ALLOW_PUBLIC_REGISTRATION=false
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
BOOTSTRAP_STAFF_EMAIL="staff@example.com"
BOOTSTRAP_STAFF_PASSWORD="ChangeMe123!"
BOOTSTRAP_USER_EMAIL="user@example.com"
BOOTSTRAP_USER_PASSWORD="ChangeMe123!"
